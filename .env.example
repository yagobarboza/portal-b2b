# ============ APP ============
APP_NAME=Portal B2B
APP_ENV=development
APP_DEBUG=false
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# ============ SECURITY ============
# Gere com: openssl rand -hex 32
SECRET_KEY=change-me-generate-a-random-64-hex
# Em segundos
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============ DATABASE (PostgreSQL) ============
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal_secret
POSTGRES_DB=portal_b2b
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# URL completa usada pela aplicação (async driver)
DATABASE_URL=postgresql+asyncpg://portal:portal_secret@postgres:5432/portal_b2b

# ============ REDIS ============
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ============ CORS ============
# Separar por vírgula. Em dev, liberar o frontend local
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============ LOGGING ============
LOG_LEVEL=INFO