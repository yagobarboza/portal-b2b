# ============ APP ============
APP_NAME=Portal B2B
APP_ENV=development
APP_DEBUG=false
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
# Desenvolvimento local: liga o job legado dentro da API. Em producao use
# false e execute `python -m worker.scheduler` como servico singleton.
API_SCHEDULER_ENABLED=true

# ============ SECURITY ============
# Gere com: openssl rand -hex 32
SECRET_KEY=change-me-generate-a-random-64-hex
# Chave separada para cifrar credenciais de integrações
INTEGRATION_ENCRYPTION_KEY=change-me-generate-another-random-64-hex
# Em segundos
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============ DATABASE (PostgreSQL) ============
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal_secret
POSTGRES_DB=portal_b2b
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# URL completa usada pela aplicação (async driver)
DATABASE_URL=postgresql+asyncpg://portal:portal_secret@postgres:5432/portal_b2b

# ============ REDIS ============
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_SSL_CA_CERTS=
REDIS_SSL_CHECK_HOSTNAME=true
REDIS_MAX_CONNECTIONS=20

# ============ CORS ============
# Separar por vírgula. Em dev, liberar o frontend local
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============ COOKIES / FRONTEND ============
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax
FRONTEND_BASE_URL=http://localhost:5173

# ============ LOGGING ============
LOG_LEVEL=INFO

# ============ OBSERVABILIDADE (Bloco 13) ============
# development | staging | production
ENVIRONMENT=development
# Deixe vazio para desligar o Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
INTEGRATION_MAX_ITEM_ERRORS=50
INTEGRATION_PAYLOAD_RETENTION_DAYS=30
INTEGRATION_EVENT_RETENTION_DAYS=90
INTEGRATION_RUN_RETENTION_DAYS=365
INTEGRATION_FAILURE_ALERT_THRESHOLD=3
INTEGRATION_STALE_SUCCESS_HOURS=24
WORKER_METRICS_PORT=9100
STORAGE_HEALTH_TIMEOUT_SECONDS=3

# Limites por processo. Calcule o total considerando todas as instancias.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800

# ============ CLOUDFLARE R2 ============
R2_ACCOUNT_ID=seu_account_id
R2_ACCESS_KEY_ID=sua_access_key
R2_SECRET_ACCESS_KEY=sua_secret_key
R2_BUCKET_NAME=portal-b2b
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
R2_ENDPOINT_URL=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com

# ============ WEBHOOKS ============
# Segredos são gerados individualmente pelo portal para cada integração.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
WEBHOOK_SECRET_ROTATION_GRACE_SECONDS=86400
WEBHOOK_PROCESSING_LEASE_SECONDS=300

# ============ E-MAIL (RESEND) ============
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portal B2B <contato@exemplo.com.br>

# ============ COBRANCA (ASAAS) ============
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_USER_AGENT=Portal B2B
BILLING_GRACE_DAYS=30
