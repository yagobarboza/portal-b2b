# Modelo de inventario. Valores sensiveis devem vir do Secret Manager.
APP_NAME=Portal B2B
APP_ENV=production
ENVIRONMENT=production
APP_DEBUG=false
API_V1_PREFIX=/api/v1
API_SCHEDULER_ENABLED=false

# Secret Manager: gerar valores diferentes com `openssl rand -hex 32`.
SECRET_KEY=SECRET_MANAGER
INTEGRATION_ENCRYPTION_KEY=SECRET_MANAGER

COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax
FRONTEND_BASE_URL=https://SEU_DOMINIO
CORS_ORIGINS=https://SEU_DOMINIO

# Cloud SQL por IP privado. Senha e URL final ficam no Secret Manager.
DATABASE_URL=SECRET_MANAGER
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800

# Memorystore por IP privado. Use rediss:// quando TLS estiver habilitado.
REDIS_URL=SECRET_MANAGER
REDIS_SSL_CA_CERTS=
REDIS_SSL_CHECK_HOSTNAME=true
REDIS_MAX_CONNECTIONS=20

LOG_LEVEL=INFO
SENTRY_DSN=SECRET_MANAGER_OPTIONAL
SENTRY_TRACES_SAMPLE_RATE=0.1
WORKER_METRICS_PORT=8080
STORAGE_HEALTH_TIMEOUT_SECONDS=3

R2_ACCOUNT_ID=SECRET_MANAGER
R2_ACCESS_KEY_ID=SECRET_MANAGER
R2_SECRET_ACCESS_KEY=SECRET_MANAGER
R2_BUCKET_NAME=portal-b2b-prod
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://ARQUIVOS_SEU_DOMINIO
R2_SIGNED_URL_EXPIRY=900

RESEND_API_KEY=SECRET_MANAGER
RESEND_FROM_EMAIL=Portal B2B <contato@SEU_DOMINIO>
ASAAS_ENV=production
ASAAS_API_KEY=SECRET_MANAGER
ASAAS_WEBHOOK_TOKEN=SECRET_MANAGER
ASAAS_USER_AGENT=Portal B2B

INTEGRATION_MAX_ITEM_ERRORS=50
INTEGRATION_PAYLOAD_RETENTION_DAYS=30
INTEGRATION_EVENT_RETENTION_DAYS=90
INTEGRATION_RUN_RETENTION_DAYS=365
INTEGRATION_FAILURE_ALERT_THRESHOLD=3
INTEGRATION_STALE_SUCCESS_HOURS=24
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
WEBHOOK_SECRET_ROTATION_GRACE_SECONDS=86400
WEBHOOK_PROCESSING_LEASE_SECONDS=300
